# Copy to .env for local use. .env is git-ignored; this example file is safe to commit.
# The app has no secrets: Elexon's API is open and the January data is bundled as CSV.

# Docker / container hosts: port the server listens on.
PORT=8000

# Set by the Dockerfile so FastAPI serves the built React app. Leave unset for local dev (Vite serves the frontend).
# FRONTEND_DIST=../frontend/dist
